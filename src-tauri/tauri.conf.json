{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cleanup Assist",
  "version": "0.2.3",
  "identifier": "com.richardgaskin.cleanupassist",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cleanup Assist",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Richard Gaskin",
    "copyright": "© 2026 Richard Gaskin",
    "shortDescription": "Find what's eating your disk — and whether it's safe to reclaim",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
